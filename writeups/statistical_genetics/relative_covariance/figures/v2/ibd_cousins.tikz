\begin{tikzpicture}[
  every node/.style={font=\small},
  pmObserved/.style={draw=black, fill=white, rectangle, inner sep=0.06cm, minimum width=0.38cm, minimum height=0.34cm},
  pmLatent/.style={draw=black, fill=white, ellipse, inner xsep=0.07cm, inner ysep=0.13cm, minimum width=0.38cm, minimum height=0.34cm},
  pmDirected/.style={-{Stealth[length=2mm]}, line width=0.7pt},
  pmBidirected/.style={{Stealth[length=2mm]}-{Stealth[length=2mm]}, line width=0.7pt},
  pmCopath/.style={line width=1.6pt},
  pmLabel/.style={midway, fill=white, inner sep=1pt},
]
  \node[pmLatent] (zh_mat_mp) at (-0.250,6.000) {$\mathring{x}^{(m)}_{m(p(i)),k}$};
  \node[pmLatent] (zh_pat_mp) at (2.250,6.000) {$\mathring{x}^{(p)}_{m(p(i)),k}$};
  \node[pmLatent] (zh_mat_pp) at (5.250,6.000) {$\mathring{x}^{(m)}_{p(p(i)),k}$};
  \node[pmLatent] (zh_pat_pp) at (7.750,6.000) {$\mathring{x}^{(p)}_{p(p(i)),k}$};
  \node[pmLatent] (zh_mat_pi) at (0.400,3.000) {$\mathring{x}^{(m)}_{p(i),k}$};
  \node[pmLatent] (zh_pat_pi) at (2.600,3.000) {$\mathring{x}^{(p)}_{p(i),k}$};
  \node[pmLatent] (zh_mat_pj) at (4.900,3.000) {$\mathring{x}^{(m)}_{p(j),k}$};
  \node[pmLatent] (zh_pat_pj) at (7.100,3.000) {$\mathring{x}^{(p)}_{p(j),k}$};
  \node[pmLatent] (zh_mat_i) at (-0.800,0.000) {$\mathring{x}^{(m)}_{ik}$};
  \node[pmLatent] (zh_pat_i) at (1.500,0.000) {$\mathring{x}^{(p)}_{ik}$};
  \node[pmLatent] (zh_mat_j) at (8.300,0.000) {$\mathring{x}^{(m)}_{jk}$};
  \node[pmLatent] (zh_pat_j) at (6.000,0.000) {$\mathring{x}^{(p)}_{jk}$};
  \draw[pmDirected, draw=black] (zh_mat_mp) -- (zh_mat_pi);
  \draw[pmDirected, draw=black] (zh_pat_mp) -- (zh_mat_pi);
  \draw[pmDirected, draw=black] (zh_mat_pp) -- (zh_pat_pi);
  \draw[pmDirected, draw=black] (zh_pat_pp) -- (zh_pat_pi);
  \draw[pmDirected, draw=black] (zh_mat_mp) -- (zh_mat_pj);
  \draw[pmDirected, draw=black] (zh_pat_mp) -- (zh_mat_pj);
  \draw[pmDirected, draw=black] (zh_mat_pp) -- (zh_pat_pj);
  \draw[pmDirected, draw=black] (zh_pat_pp) -- (zh_pat_pj);
  \draw[pmDirected, draw=black] (zh_mat_pi) -- (zh_pat_i);
  \draw[pmDirected, draw=black] (zh_pat_pi) -- (zh_pat_i);
  \draw[pmDirected, draw=black] (zh_mat_pj) -- (zh_pat_j);
  \draw[pmDirected, draw=black] (zh_pat_pj) -- (zh_pat_j);
\end{tikzpicture}
