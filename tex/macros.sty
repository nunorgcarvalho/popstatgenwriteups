% Text shortcuts
\newcommand{\sps}[1]{\textsuperscript{#1}} % superscripts in text (or math) mode

% Math operators
\DeclareMathOperator*{\argmin}{arg\,min}

% Shorthand symbols
\newcommand{\T}{^\intercal}
\newcommand{\N}{\mathcal{N}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\Rsq}{\mathrm{R}^2}
\newcommand{\LL}{\mathrm{L}} % log-likelihood, just a single L

\newcommand{\E}{\mathrm{E}} % expected value
\newcommand{\Var}{\mathrm{Var}} % variance
\newcommand{\Cov}{\mathrm{Cov}} % covariance
\newcommand{\Corr}{\mathrm{Corr}} % correlation
\newcommand{\diag}{\mathrm{diag}} % diagonal (of a matrix)
\newcommand{\IBD}{\mathrm{IBD}} % identical-by-descent

% Generation-indexed variance components. Under assortative mating the additive variance is
% no longer constant across generations, so the scale has to be pinned to a named generation:
% (0) = the randomly mating base population, (eq) = the assortative-mating equilibrium.
\newcommand{\VAo}{V_A^{(0)}}            % additive variance in the base population
\newcommand{\VAeq}{V_A^{(\mathrm{eq})}} % additive variance at equilibrium
\newcommand{\VPo}{V_P^{(0)}}            % phenotypic variance in the base population
\newcommand{\VPeq}{V_P^{(\mathrm{eq})}} % phenotypic variance at equilibrium
\newcommand{\hsqo}{h^2_{(0)}}           % heritability in the base population
\newcommand{\hsqeq}{h^2_{(\mathrm{eq})}}% heritability at equilibrium
% The same quantities in an unspecified generation t, for stating the convention and the
% recursions. rho_y and V_E are the only generation-invariant quantities and get no superscript.
\newcommand{\VAt}{V_A^{(t)}}            % additive variance in generation t
\newcommand{\VPt}{V_P^{(t)}}            % phenotypic variance in generation t
\newcommand{\hsqt}{h^2_{(t)}}           % heritability in generation t
\newcommand{\mut}{\mu^{(t)}}            % co-path coefficient in generation t
\newcommand{\muo}{\mu^{(0)}}            % co-path coefficient in the base population
\newcommand{\mueq}{\mu^{(\mathrm{eq})}} % co-path coefficient at equilibrium
\newcommand{\rhogt}{\rho_g^{(t)}}       % mates' genetic correlation in generation t
\newcommand{\rhogo}{\rho_g^{(0)}}       % mates' genetic correlation in the base population
\newcommand{\rhogeq}{\rho_g^{(\mathrm{eq})}} % mates' genetic correlation at equilibrium

\newcommand{\varg}{\sigma_g^2} % genetic variance
\newcommand{\vareps}{\sigma_{\epsilon}^2} % genetic variance
\newcommand{\varbeta}{\sigma_{\beta}^2} % genetic variance


