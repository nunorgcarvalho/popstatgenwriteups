% info %%%%
\author{Nuno Carvalho}

% aesthetics %%%%
\geometry{a4paper, margin=1in}

\setlist[itemize]{nosep, label=--}

% Lets TeX stretch a line a little more before it gives up and overruns the margin, which long
% unbreakable items (assumption ids, inline maths) otherwise cause.
\setlength{\emergencystretch}{3em}

% Remove paragraph indentation and add vertical spacing between paragraphs
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.75em}

% notes in the source
% \todo     -- directions for something that needs to be done; often carried out by an agent.
% \question -- a question, answered in chat rather than by editing the document.
% \toself   -- a note from the author to the author; needs no answer. Italic as well as coloured,
%              so it is distinguishable from a todo even in greyscale.
% \toagent  -- a note meant only for agents (e.g., the do-not-edit markers). NOT rendered: it
%              expands to nothing, so it lives in the source alone.
% \unsure and \comment are the older names (still used by relative_covariance_v1); new text uses
% \question and \toself / \toagent instead.
% The rendered notes take whole paragraphs: \textcolor cannot (its argument may not contain \par,
% so a note with a blank line in it fails with "Paragraph ended before \@textcolor was complete"),
% so they switch colour inside a group instead. \leavevmode stops a note that opens a paragraph
% from putting the colour change in vertical mode, which would add a spurious line of space.
\newcommand{\todo}[1]{{\leavevmode\color{blue}#1}}
\newcommand{\question}[1]{{\leavevmode\color{orange}#1}}
\definecolor{commentink}{RGB}{110,85,145}
\newcommand{\toself}[1]{{\leavevmode\color{commentink}\itshape #1}}
\newcommand{\toagent}[1]{}
\newcommand{\unsure}[1]{{\leavevmode\color{orange}#1}}
\newcommand{\comment}[1]{{\leavevmode\color{commentink}\itshape #1}}

% revision markup -- \add marks text being introduced, \remove text being taken out, so that a
% large rewrite can be read against what it replaces. Both are scaffolding: they are meant to be
% stripped once the revision is accepted, not to live in the document. Not used by default: only
% when the author asks for a change to be shown this way.
%
% \remove is red AND struck through, so the two stay distinguishable in greyscale. It strikes
% word by word: ulem's \sout would do it in one step, but ulem is not in this TeX installation
% and this pipeline avoids adding package dependencies (same call as \@makecaption above).
% Putting each word in its own box leaves the inter-word glue intact, which is what lets a long
% span still break across lines. The one cost is that a "word" must not contain a space at brace
% level zero, so BRACE-PROTECT any inline maths that has spaces in it: {$X \rightarrow Y$},
% not $X \rightarrow Y$. A macro argument needs nothing, since braces already hide its spaces.
%
% Display maths, blank lines and list environments cannot be struck at all. Whole paragraphs,
% equations and lists therefore go in the `removed` environment, which marks the block with a
% red rule down the left margin instead of striking it; `added` is its green counterpart.
\definecolor{addink}{RGB}{20,110,75}
\definecolor{removeink}{RGB}{176,58,46}
\newcommand{\add}[1]{\textcolor{addink}{#1}}
\makeatletter
\newcommand{\pgwstrike}[1]{%
  \leavevmode\setbox\z@\hbox{#1}%
  \rlap{\vrule\@height.58ex\@depth-.50ex\@width\wd\z@}\box\z@}
\def\pgwstrikeloop#1 #2\pgwstrikeend{%
  \pgwstrike{#1}%
  \def\pgwstriketmp{#2}%
  \ifx\pgwstriketmp\@empty\else\ \pgwstrikeloop#2\pgwstrikeend\fi}
\newcommand{\remove}[1]{\textcolor{removeink}{\pgwstrikeloop#1 \pgwstrikeend}}
\newenvironment{pgwbar}[1]{%
  \par\smallskip\color{#1}%
  \def\FrameCommand{{\color{#1}\vrule width 2pt}\hspace{8pt}}%
  \MakeFramed{\advance\hsize-\width \FrameRestore}%
}{%
  \endMakeFramed\par\smallskip%
}
\makeatother
\newenvironment{added}{\begin{pgwbar}{addink}}{\end{pgwbar}}
\newenvironment{removed}{\begin{pgwbar}{removeink}}{\end{pgwbar}}

% appendices %%%%
% \appendixsections replaces \appendix. Each later \section is headed "Appendix A: Title", is
% cited as "Appendix~\ref{...}" -> "Appendix A", and numbers its equations, figures and tables
% as A1, A2, ... (no dot), restarting in every appendix. The \theH... redefinitions give
% hyperref distinct anchors, so "Figure A1" cannot link to the main text's Figure 1.
\makeatletter
\newcommand{\appendixsections}{%
  \appendix
  \renewcommand{\thesection}{\Alph{section}}%
  \renewcommand{\thesubsection}{\thesection.\arabic{subsection}}%
  \renewcommand{\theequation}{\thesection\arabic{equation}}%
  \renewcommand{\thefigure}{\thesection\arabic{figure}}%
  \renewcommand{\thetable}{\thesection\arabic{table}}%
  \renewcommand{\theHsection}{appendix.\Alph{section}}%
  \renewcommand{\theHequation}{appendix.\Alph{section}.\arabic{equation}}%
  \renewcommand{\theHfigure}{appendix.\Alph{section}.\arabic{figure}}%
  \renewcommand{\theHtable}{appendix.\Alph{section}.\arabic{table}}%
  \@addtoreset{equation}{section}\@addtoreset{figure}{section}\@addtoreset{table}{section}%
  \renewcommand{\@seccntformat}[1]{%
    \ifnum\pdfstrcmp{##1}{section}=0 Appendix~\thesection:\ \else\csname the##1\endcsname\quad\fi}%
}
\makeatother

% floats %%%%
% Captions are set smaller than body text with a bold label, so a caption is visibly not body
% text -- which matters here, where captions are long enough to be mistaken for a paragraph.
% The `caption` package is not in this TeX installation, so this redefines the kernel's
% \@makecaption directly. The two branches are the original ones: a caption that fits on one
% line is centred, a longer one is set as a normal paragraph.
\makeatletter
\long\def\@makecaption#1#2{%
  \vskip\abovecaptionskip
  \begingroup\small
    % A floatcard centres its contents; a caption is prose and must not inherit that, or every
    % line of a wrapped caption comes out centred. Undo it locally rather than at the call site.
    \leftskip\z@skip \rightskip\z@skip \parindent\z@
    \parfillskip\z@ \@plus 1fil\relax
    \sbox\@tempboxa{\textbf{#1:}~#2}%
    \ifdim \wd\@tempboxa >\hsize
      \textbf{#1:}~#2\par
    \else
      \global\@minipagefalse
      \hb@xt@\hsize{\hfil\box\@tempboxa\hfil}%
    \fi
  \endgroup
  \vskip\belowcaptionskip}
\makeatother

% Emphasis for the term that assortative mating ADDS to a randomly mating value, so a reader can
% see at a glance which half of an expression is new. Colour rather than \emph, because \emph
% does nothing useful inside math mode -- math is already italic.
\definecolor{addedterm}{RGB}{20,110,75}
\newcommand{\adds}[1]{{\color{addedterm}#1}}

% A bordered panel around a float's contents AND its caption, so a figure or table reads as one
% object rather than as loose material sitting in the text column. Built as an \fbox around a
% minipage rather than on `framed`, because the caption goes inside and \caption is only reliably
% behaved inside a box that is set in one piece.
% Usage -- note the caption is INSIDE the environment:
%   \begin{figure}[H]
%     \begin{floatcard} <tikzpicture, or tabular> \caption{...}\label{...} \end{floatcard}
%   \end{figure}
\definecolor{floatrule}{RGB}{196,196,206}
\newsavebox{\floatcardbox}
\newlength{\floatcardsep}\setlength{\floatcardsep}{9pt}
\newenvironment{floatcard}{%
  \begin{lrbox}{\floatcardbox}%
  \begin{minipage}{\dimexpr\linewidth-2\floatcardsep-1pt\relax}%
  \setlength{\parskip}{0.5em}%
  \centering%
}{%
  \end{minipage}%
  \end{lrbox}%
  % The contents are already typeset inside the savebox, so this colour reaches only the rule.
  {\setlength{\fboxsep}{\floatcardsep}\setlength{\fboxrule}{0.4pt}%
   \color{floatrule}\fbox{\usebox{\floatcardbox}}}%
}

% assumption boxes %%%%
% A visually distinct, page-breakable box for stating a modeling assumption.
% Usage:
%   \begin{assumption}{A3}{Random, exchangeable causal effects}
%     <mathematical statement>
%     \related{the infinitesimal / random-effects model; implied by \assumptionid{A7} (Section~\ref{...}).}
%   \end{assumption}
% Arg 1 is a STABLE identifier (e.g. A3) meant to be reused verbatim across writeups when
% the same assumption reappears; arg 2 is a short human-readable name. \related{...} is one
% optional trailing note listing concepts with similar definitions or requirements (not a 1-to-1
% mapping), and, for assumptions stated elsewhere in the writeup, a short blurb on how they relate
% and where they are stated. Record such a relationship in BOTH boxes, so that it can be found
% from either end. \bundles{...} ("Commonly bundled into:") is the older, separate note; it is
% kept for relative_covariance_v1 only.
%
% Cross-references: every box sets a hyperref anchor named after its id, and \assumptionid{X} /
% \approximationid{X} in the text link to it, so clicking a cited id jumps to its box. Citing an
% id that has no box in the same file gives a hyperref "destination ... does not exist" warning,
% not an error. Ids may contain hyphens; \breakid lets a long id break across lines after one.
\makeatletter
\def\breakid#1{\breakid@#1-\@nil}
\def\breakid@#1-#2\@nil{#1\ifx\relax#2\relax\else-\allowbreak\breakid@#2\@nil\fi}
\makeatother
\definecolor{assumptionframe}{RGB}{40,90,150}
\definecolor{assumptionback}{RGB}{238,243,249}
\newcommand{\assumptionlabel}[1]{{\bfseries\color{assumptionframe}[\breakid{#1}]}}
\newcommand{\assumptionid}[1]{\hyperlink{assumption.#1}{\assumptionlabel{#1}}}
\newcommand{\bundles}[1]{\par\smallskip{\small\textit{Commonly bundled into:} #1}}
\newcommand{\related}[1]{\par\smallskip{\small\textit{Related:} #1}}
\newenvironment{assumption}[2]{%
  \par\smallskip%
  \colorlet{shadecolor}{assumptionback}%
  \begin{shaded}%
  \setlength{\parskip}{0.4em}%
  \noindent\hypertarget{assumption.#1}{}\assumptionlabel{#1}~\textbf{#2}\par\nobreak\smallskip%
}{%
  \end{shaded}\par\smallskip%
}

% approximation boxes %%%%
% Same shape as an assumption box, but for a statement that is strictly FALSE and adopted
% anyway. The distinction matters: an assumption answers "what must I believe?", an
% approximation answers "what am I neglecting?". Approximations are therefore expected to
% carry a \justification block -- a short, small-font argument for why the approximation is
% reasonable. Where the size of the neglected term is known, saying so is worth the space,
% but the block does not have to end in an error term.
% Usage:
%   \begin{approximation}{Same-locus-AM}{Assortment does not change per-locus quantities}
%     <statement>
%     \justification{<why the approximation is reasonable>}
%     \bundles{...}   % optional, same as for assumptions
%   \end{approximation}
\definecolor{approximationframe}{RGB}{160,95,20}
\definecolor{approximationback}{RGB}{252,246,235}
\newcommand{\approximationlabel}[1]{{\bfseries\color{approximationframe}[\breakid{#1}]}}
\newcommand{\approximationid}[1]{\hyperlink{approximation.#1}{\approximationlabel{#1}}}
\newcommand{\justification}[1]{%
  \par\smallskip%
  {\small\textit{\color{approximationframe}Justification:}\ #1}%
}
\newenvironment{approximation}[2]{%
  \par\smallskip%
  \colorlet{shadecolor}{approximationback}%
  \begin{shaded}%
  \setlength{\parskip}{0.4em}%
  \noindent\hypertarget{approximation.#1}{}\approximationlabel{#1}~\textbf{#2}\par\nobreak\smallskip%
}{%
  \end{shaded}\par\smallskip%
}

