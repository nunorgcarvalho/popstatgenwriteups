% assumption boxes %%%%
% A visually distinct, page-breakable box for stating a modeling assumption.
% Usage:
%   \begin{assumption}{A3}{Random, exchangeable causal effects}
%     <mathematical statement>
%     \bundles{the infinitesimal / random-effects model}
%   \end{assumption}
% Arg 1 is a STABLE identifier (e.g. A3) meant to be reused verbatim across writeups when
% the same assumption reappears; arg 2 is a short human-readable name. \bundles{...} is an
% optional trailing note listing the common terminology that implies this assumption.
\definecolor{assumptionframe}{RGB}{40,90,150}
\definecolor{assumptionback}{RGB}{238,243,249}
\newcommand{\assumptionid}[1]{{\bfseries\color{assumptionframe}[#1]}}
\newcommand{\bundles}[1]{\par\smallskip{\small\textit{Commonly bundled into:} #1}}
\newenvironment{assumption}[2]{%
  \par\smallskip%
  \colorlet{shadecolor}{assumptionback}%
  \begin{shaded}%
  \setlength{\parskip}{0.4em}%
  \noindent\assumptionid{#1}~\textbf{#2}\par\nobreak\smallskip%
}{%
  \end{shaded}\par\smallskip%
}

% approximation boxes %%%%
% Same shape as an assumption box, but for a statement that is strictly FALSE and adopted
% anyway because the error it introduces is negligible. The distinction matters: an
% assumption answers "what must I believe?", an approximation answers "what am I neglecting,
% and how big is it?". Approximations are therefore expected to carry a \justification block
% -- a short, small-font order-of-magnitude argument ending in an explicit error term.
% Usage:
%   \begin{approximation}{Same-locus-AM}{Assortment does not change per-locus quantities}
%     <statement>
%     \justification{<why the neglected term is small, with its order>}
%     \bundles{...}   % optional, same as for assumptions
%   \end{approximation}
\definecolor{approximationframe}{RGB}{160,95,20}
\definecolor{approximationback}{RGB}{252,246,235}
\newcommand{\approximationid}[1]{{\bfseries\color{approximationframe}[#1]}}
\newcommand{\justification}[1]{%
  \par\smallskip%
  {\small\textit{\color{approximationframe}Why the error is negligible:}\ #1}%
}
\newenvironment{approximation}[2]{%
  \par\smallskip%
  \colorlet{shadecolor}{approximationback}%
  \begin{shaded}%
  \setlength{\parskip}{0.4em}%
  \noindent\approximationid{#1}~\textbf{#2}\par\nobreak\smallskip%
}{%
  \end{shaded}\par\smallskip%
}

